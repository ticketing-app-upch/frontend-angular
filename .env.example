# Copia este archivo a `.env` (no se sube al repo) y ajusta los valores.
# `npm start` / `npm run build` los aplican a src/enviroments/enviroment*.ts
# mediante scripts/set-env.mjs. Sin `.env` se usan los valores del repo (modo mock).

# URL base del backend (sin "/" final). Cada llamada es: API_BACKEND_URL + endpoint,
# por ejemplo http://localhost:8080/api + /events
API_BACKEND_URL=http://localhost:8080/api

# URL base del servicio de precios. El backend también expone /v1/dynamic-price.
API_PRICING_URL=http://localhost:8080/api

# true = datos de maqueta en el navegador; false = llama al backend real.
USE_MOCK=false

# true = login simulado; false = login contra el backend.
USE_MOCK_AUTH=false
